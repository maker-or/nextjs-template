# The CLI writes these values to .env.local.
NEXT_PUBLIC_OPENCMS_PROJECT_ID=
# Set this to the OpenCMS API/control-plane origin. The CLI fills this for generated apps.
OPENCMS_API_URL=
OPENCMS_ENVIRONMENT=development
# Optional comma-separated LAN hostnames/IPs for Next.js development HMR.
NEXT_ALLOWED_DEV_ORIGINS=
