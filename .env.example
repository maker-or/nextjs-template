# The CLI writes the first three values to .env.local.
NEXT_PUBLIC_OPENCMS_PROJECT_ID=
# Set this to the OpenCMS API origin. The CLI fills this for generated apps.
OPENCMS_API_URL=
OPENCMS_ENVIRONMENT=development

# Optional server-only token for private OpenCMS API reads.
# Never rename this to NEXT_PUBLIC_OPENCMS_API_TOKEN.
OPENCMS_API_TOKEN=
